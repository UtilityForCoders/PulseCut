<Window x:Class="PulseCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PulseCut" Width="1050" Height="720" MinWidth="720" MinHeight="625"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Window}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="14" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource Window}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Background="{StaticResource Panel}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,5,5,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="Minimizar"
                        ToolTip="Minimizar" Click="OnMinimizeWindow"/>
                <Button Click="OnToggleWindowState">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="Content" Value="&#xE922;"/>
                            <Setter Property="AutomationProperties.Name" Value="Maximizar"/>
                            <Setter Property="ToolTip" Value="Maximizar"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;"/>
                                    <Setter Property="AutomationProperties.Name" Value="Restaurar"/>
                                    <Setter Property="ToolTip" Value="Restaurar"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" AutomationProperties.Name="Cerrar"
                        ToolTip="Cerrar" Click="OnCloseWindow"/>
            </StackPanel>
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="_Abrir archivo" Click="OnOpen" Margin="12,0,10,0"
                    Padding="11,5" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <TextBlock x:Name="LocalFileLabel" DockPanel.Dock="Right" Text="●  Archivo local" Visibility="Collapsed"
                       Foreground="{StaticResource Signal}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Border DockPanel.Dock="Left" Width="29" Height="29" CornerRadius="6" Background="{StaticResource Hover}" Margin="14,0,0,0">
                <Path Data="M 2,10 L 7,10 L 9,5 L 12,15 L 14,10 L 19,10"
                      Stroke="{StaticResource Ink}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock DockPanel.Dock="Left" Text="PulseCut" FontSize="19" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Left" Width="1" Height="20" Margin="14,0" Background="{StaticResource Line}"/>
            <TextBlock x:Name="FileTitle" Text="Sin archivo" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="252"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#08090B" CornerRadius="5" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                          MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                            <TextBlock x:Name="PreviewMessage" Text="Abre o arrastra un video o audio"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="20" Foreground="{StaticResource Muted}"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4"
                                    CornerRadius="4" Background="#E0101115" IsHitTestVisible="False">
                                <TextBlock Text="VISTA PREVIA" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,9,0,0" Padding="8,6" CornerRadius="5" Background="{StaticResource Hover}">
                        <Grid>
                            <StackPanel x:Name="MarkControls" Orientation="Horizontal" HorizontalAlignment="Left" IsEnabled="False">
                                <Button Content="[ Inicio" Padding="8,5" FontSize="12" Click="OnMarkStart" ToolTip="Marcar inicio en la posición actual"/>
                                <Button Content="Fin ]" Padding="8,5" FontSize="12" Margin="5,0,0,0" Click="OnMarkEnd" ToolTip="Marcar fin en la posición actual"/>
                            </StackPanel>
                            <Button x:Name="PlayButton" Content="_Reproducir" HorizontalAlignment="Center" IsEnabled="False" Click="OnPlay" Padding="14,5"/>
                            <TextBlock x:Name="PreviewInfo" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,12"/>
                        <Button x:Name="ExportButton" Content="_Exportar clip" Style="{StaticResource Primary}"
                                IsEnabled="False" Click="OnExport"/>
                        <Button x:Name="CancelButton" Content="Cancelar" Margin="0,8,0,0" Visibility="Collapsed" Click="OnCancel"/>
                        <ProgressBar x:Name="ExportProgress" Height="5" Margin="0,10,0,0" Maximum="100"
                                     Foreground="{StaticResource Signal}" Visibility="Collapsed"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="RECORTE Y SALIDA" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,15"/>
                        <StackPanel x:Name="EditControls" IsEnabled="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Inicio (s)" Margin="0,0,0,5" Foreground="{StaticResource Muted}"/>
                                    <TextBox x:Name="StartBox" Text="0" TextChanged="OnSettingsChanged" AutomationProperties.Name="Inicio en segundos"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fin (s)" Margin="0,0,0,5" Foreground="{StaticResource Muted}"/>
                                    <TextBox x:Name="EndBox" Text="0" TextChanged="OnSettingsChanged" AutomationProperties.Name="Fin en segundos"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Velocidad de salida" Margin="0,14,0,5" Foreground="{StaticResource Muted}"/>
                            <ComboBox x:Name="SpeedBox" SelectionChanged="OnSettingsChanged" ItemStringFormat="{}{0}×" AutomationProperties.Name="Velocidad de salida"/>
                            <TextBlock Text="Formato de salida" Margin="0,12,0,5" Foreground="{StaticResource Muted}"/>
                            <ComboBox x:Name="FormatBox" SelectionChanged="OnSettingsChanged" AutomationProperties.Name="Formato de salida"/>
                            <TextBlock x:Name="CodecLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                            <Border Background="{StaticResource Window}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="5" Padding="9,8" Margin="0,14,0,0">
                            <DockPanel>
                                <TextBlock Text="Duración final" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DurationLabel" Text="—" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Foreground="{StaticResource Signal}"/>
                            </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Margin="14,12,14,0" Padding="12,9,12,12" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="LÍNEA DE TIEMPO" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PositionLabel" Text="00:00.00 / 00:00.00" HorizontalAlignment="Right" FontFamily="Consolas"
                               Foreground="{StaticResource Muted}" FontSize="12"/>
                </DockPanel>
                <Grid Height="16" Margin="16,0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="00:00" Style="{StaticResource TimelineTick}"/>
                    <TextBlock x:Name="TickQuarter" Grid.Column="1" Style="{StaticResource TimelineTick}"/>
                    <TextBlock x:Name="TickHalf" Grid.Column="2" Style="{StaticResource TimelineTick}"/>
                    <TextBlock x:Name="TickThreeQuarter" Grid.Column="3" Style="{StaticResource TimelineTick}"/>
                    <TextBlock x:Name="TickEnd" Grid.Column="3" Style="{StaticResource TimelineTick}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Height="34" x:Name="TimelineSurface" SizeChanged="OnTimelineSizeChanged">
                    <Border Margin="16,2" CornerRadius="4" Background="{StaticResource Hover}"/>
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="TrimSelection" Height="30" Canvas.Top="2" Background="#38F5F6F8"
                                BorderBrush="#91F5F6F8" BorderThickness="0,1" Visibility="Collapsed"/>
                    </Canvas>
                    <Slider x:Name="PositionSlider" IsEnabled="False" IsMoveToPointEnabled="True"
                            ValueChanged="OnPositionChanged" AutomationProperties.Name="Posición de reproducción">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TimelineHitArea}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TimelineHitArea}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="32" Cursor="SizeWE">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent"><Border Width="2" Background="{StaticResource Signal}"/></Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                    <Canvas>
                        <Thumb x:Name="StartHandle" Style="{StaticResource TrimHandle}" Visibility="Collapsed" HorizontalContentAlignment="Right"
                               DragStarted="OnTrimDragStarted" DragDelta="OnTrimDrag" KeyDown="OnTrimKeyDown"
                               AutomationProperties.Name="Inicio del recorte" ToolTip="Arrastra para ajustar el inicio"/>
                        <Thumb x:Name="EndHandle" Style="{StaticResource TrimHandle}" Visibility="Collapsed" HorizontalContentAlignment="Left"
                               DragStarted="OnTrimDragStarted" DragDelta="OnTrimDrag" KeyDown="OnTrimKeyDown"
                               AutomationProperties.Name="Fin del recorte" ToolTip="Arrastra para ajustar el fin"/>
                    </Canvas>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusLabel" Grid.Row="3" Margin="15,8,14,9" Foreground="{StaticResource Muted}" FontSize="12"
                   Text="Procesamiento local en Windows" TextWrapping="Wrap" MaxHeight="52"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
    </Border>
</Window>
