<Window x:Class="PulseCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PulseCut" Icon="/Assets/PulseCut.ico" Width="1280" Height="820" MinWidth="940" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Window}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing" PreviewKeyDown="OnWindowKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="10" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Window}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="TimelineRow" Height="202"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Grid Grid.Row="0" Background="{StaticResource Surface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                    <Image Width="25" Height="25" Source="/Assets/PulseCutLogo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PulseCut" Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Menu Grid.Column="1" VerticalAlignment="Stretch" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="Archivo">
                        <MenuItem Header="Abrir archivo…" InputGestureText="Ctrl+O" Click="OnOpen"/>
                        <MenuItem Header="Exportar…" InputGestureText="Ctrl+E" Click="OnExport"/>
                        <Separator/>
                        <MenuItem Header="Salir" Click="OnCloseWindow"/>
                    </MenuItem>
                    <MenuItem Header="Herramientas">
                        <MenuItem Header="Recorte" Click="OnShowTrim"/>
                        <MenuItem Header="Velocidad" Click="OnShowSpeed"/>
                        <MenuItem Header="Ajustes de salida" Click="OnShowOutput"/>
                    </MenuItem>
                    <MenuItem Header="Ayuda">
                        <MenuItem Header="Acerca de PulseCut" Click="OnAbout"/>
                    </MenuItem>
                </Menu>
                <TextBlock x:Name="FileTitle" Grid.Column="2" Text="Sin archivo abierto" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar" Click="OnMinimizeWindow"/>
                    <Button Click="OnToggleWindowState">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Setter Property="ToolTip" Value="Maximizar"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                        <Setter Property="ToolTip" Value="Restaurar"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Cerrar" Click="OnCloseWindow"/>
                </StackPanel>
            </Grid>

            <!-- Área de trabajo -->
            <Grid x:Name="Workspace" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PropertiesColumn" Width="310"/>
                </Grid.ColumnDefinitions>

                <!-- Navegación lateral -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
                    <StackPanel Margin="0,10">
                        <RadioButton x:Name="EditNavigation" GroupName="Navigation" Style="{StaticResource SideNavigation}"
                                     Content="Editar" Tag="&#xE70F;" IsChecked="True" Click="OnNavigateEdit"/>
                        <RadioButton GroupName="Navigation" Style="{StaticResource SideNavigation}"
                                     Content="Ajustes" Tag="&#xE713;" Click="OnNavigateSettings"/>
                        <RadioButton GroupName="Navigation" Style="{StaticResource SideNavigation}"
                                     Content="Exportar" Tag="&#xE898;" Click="OnNavigateExport"/>
                    </StackPanel>
                </Border>

                <!-- Visor -->
                <Grid Grid.Column="1" Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>
                    <Border Background="#080A0F" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                          MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                            <Grid x:Name="EmptyPreview" Background="#080A0F">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                    <Border Width="58" Height="58" CornerRadius="12" Background="{StaticResource Panel}" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EmptyIcon" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="PreviewMessage" Text="Abre o arrastra un video o audio aquí" FontSize="16"
                                               FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,5"/>
                                    <TextBlock x:Name="PreviewHint" Text="El procesamiento se realiza en tu equipo" Foreground="{StaticResource Muted}"
                                               TextAlignment="Center" Margin="0,0,0,18"/>
                                    <Button x:Name="OpenButton" Content="Abrir archivo" Style="{StaticResource Primary}"
                                            HorizontalAlignment="Center" Click="OnOpen"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="MediaBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="12" Padding="8,4" CornerRadius="6" Background="#D9151820">
                                <TextBlock x:Name="PreviewInfo" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Controles de reproducción -->
                    <Grid Grid.Row="1" Margin="2,8,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionLabel" Text="00:00.00 / 00:00.00" FontFamily="Consolas"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE100;" ToolTip="Retroceder 5 segundos (←)" Click="OnSeekBackward"/>
                            <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="17"
                                    ToolTip="Reproducir (Espacio)" IsEnabled="False" Click="OnPlay" Margin="5,0"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE101;" ToolTip="Avanzar 5 segundos (→)" Click="OnSeekForward"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="VolumeSlider" Width="92" Minimum="0" Maximum="1" Value="0.8"
                                    VerticalAlignment="Center" ValueChanged="OnVolumeChanged" ToolTip="Volumen de vista previa"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Pantalla completa" Click="OnToggleFullscreen" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Propiedades -->
                <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Background="{StaticResource Surface}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="TrimTab" GroupName="Properties" Style="{StaticResource PropertyTab}" Content="Recorte"
                                         IsChecked="True" Click="OnPropertyTab" Tag="Trim"/>
                            <RadioButton x:Name="SpeedTab" Grid.Column="1" GroupName="Properties" Style="{StaticResource PropertyTab}"
                                         Content="Velocidad" Click="OnPropertyTab" Tag="Speed"/>
                            <RadioButton x:Name="OutputTab" Grid.Column="2" GroupName="Properties" Style="{StaticResource PropertyTab}"
                                         Content="Ajustes" Click="OnPropertyTab" Tag="Output"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16">
                            <Grid x:Name="EditControls" IsEnabled="False">
                                <!-- Recorte -->
                                <StackPanel x:Name="TrimPanel">
                                    <TextBlock Text="Intervalo del clip" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Define el fragmento que quieres conservar." Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,4,0,18"/>
                                    <TextBlock Text="Inicio" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="StartBox" Text="0" TextChanged="OnSettingsChanged" AutomationProperties.Name="Inicio en segundos"/>
                                        <TextBlock Text="s" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button Content="Usar posición actual como inicio" Margin="0,8,0,15" Click="OnMarkStart"/>
                                    <TextBlock Text="Fin" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="EndBox" Text="0" TextChanged="OnSettingsChanged" AutomationProperties.Name="Fin en segundos"/>
                                        <TextBlock Text="s" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button Content="Usar posición actual como fin" Margin="0,8,0,18" Click="OnMarkEnd"/>
                                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="11">
                                        <DockPanel>
                                            <TextBlock Text="Duración resultante" Foreground="{StaticResource Muted}"/>
                                            <TextBlock x:Name="DurationLabel" Text="—" HorizontalAlignment="Right" FontFamily="Consolas"
                                                       Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Velocidad -->
                                <StackPanel x:Name="SpeedPanel" Visibility="Collapsed">
                                    <TextBlock Text="Velocidad de salida" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Se aplicará al exportar. La vista previa conserva su velocidad normal."
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                                    <WrapPanel>
                                        <RadioButton GroupName="Speed" Style="{StaticResource SpeedChoice}" Content="0.5×" Tag="0.5" Click="OnSpeedSelected"/>
                                        <RadioButton GroupName="Speed" Style="{StaticResource SpeedChoice}" Content="0.75×" Tag="0.75" Click="OnSpeedSelected"/>
                                        <RadioButton x:Name="NormalSpeed" GroupName="Speed" Style="{StaticResource SpeedChoice}" Content="1×" Tag="1" IsChecked="True" Click="OnSpeedSelected"/>
                                        <RadioButton GroupName="Speed" Style="{StaticResource SpeedChoice}" Content="1.5×" Tag="1.5" Click="OnSpeedSelected"/>
                                        <RadioButton GroupName="Speed" Style="{StaticResource SpeedChoice}" Content="2×" Tag="2" Click="OnSpeedSelected"/>
                                    </WrapPanel>
                                    <ComboBox x:Name="SpeedBox" Visibility="Collapsed" SelectionChanged="OnSettingsChanged"/>
                                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="11" Margin="0,15,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Duración final" Foreground="{StaticResource Muted}"/>
                                            <TextBlock x:Name="SpeedDurationLabel" Text="—" HorizontalAlignment="Right" FontFamily="Consolas"
                                                       Foreground="{StaticResource Accent}"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Ajustes de salida -->
                                <StackPanel x:Name="OutputPanel" Visibility="Collapsed">
                                    <TextBlock Text="Salida" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Opciones compatibles con el archivo actual." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
                                    <TextBlock Text="Formato" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="FormatBox" SelectionChanged="OnSettingsChanged"/>
                                    <TextBlock x:Name="CodecLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="1,6,0,16"/>
                                    <TextBlock Text="Resolución" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ResolutionBox" SelectionChanged="OnSettingsChanged">
                                        <ComboBoxItem Content="Original" Tag="original" IsSelected="True"/>
                                        <ComboBoxItem Content="1080p" Tag="1080"/>
                                        <ComboBoxItem Content="720p" Tag="720"/>
                                        <ComboBoxItem Content="480p" Tag="480"/>
                                    </ComboBox>
                                    <TextBlock Text="Calidad" Foreground="{StaticResource Muted}" Margin="0,15,0,6"/>
                                    <ComboBox x:Name="QualityBox" SelectionChanged="OnSettingsChanged">
                                        <ComboBoxItem Content="Rápida" Tag="fast"/>
                                        <ComboBoxItem Content="Equilibrada" Tag="balanced" IsSelected="True"/>
                                        <ComboBoxItem Content="Alta" Tag="high"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="18,12,18,17">
                            <ProgressBar x:Name="ExportProgress" Height="4" Maximum="100" Foreground="{StaticResource Accent}"
                                         Background="{StaticResource Line}" Visibility="Collapsed" Margin="0,0,0,10"/>
                            <Button x:Name="ExportButton" Content="Exportar clip" Style="{StaticResource Primary}"
                                    IsEnabled="False" Click="OnExport"/>
                            <Grid Margin="0,8,0,0">
                                <Button x:Name="CancelButton" Content="Cancelar exportación" Visibility="Collapsed" Click="OnCancel"/>
                                <Button x:Name="OpenFolderButton" Content="Abrir carpeta del resultado" Visibility="Collapsed" Click="OnOpenExportFolder"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Línea de tiempo -->
            <Border x:Name="TimelineArea" Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="14,10,14,11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Deshacer (Ctrl+Z)" Click="OnUndo" IsEnabled="False"/>
                            <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Rehacer (Ctrl+Y)" Click="OnRedo" IsEnabled="False"/>
                            <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="6,7"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Quitar selección de recorte (Supr)" Click="OnClearSelection"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Zoom" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Alejar" Click="OnZoomOut"/>
                            <Slider x:Name="ZoomSlider" Width="92" Minimum="1" Maximum="8" Value="1" TickFrequency="1"
                                    ValueChanged="OnZoomChanged" VerticalAlignment="Center" ToolTip="Zoom de línea de tiempo"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Acercar" Click="OnZoomIn"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer x:Name="TimelineViewport" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnTimelineMouseWheel">
                        <Grid x:Name="TimelineSurface" MinWidth="600" Height="128" SizeChanged="OnTimelineSizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="58"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="16,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="00:00" Style="{StaticResource TimelineTick}"/>
                                <TextBlock x:Name="TickQuarter" Grid.Column="1" Style="{StaticResource TimelineTick}"/>
                                <TextBlock x:Name="TickHalf" Grid.Column="2" Style="{StaticResource TimelineTick}"/>
                                <TextBlock x:Name="TickThreeQuarter" Grid.Column="3" Style="{StaticResource TimelineTick}"/>
                                <TextBlock x:Name="TickEnd" Grid.Column="3" Style="{StaticResource TimelineTick}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Border x:Name="TimelineTrack" Margin="16,2" CornerRadius="7" Background="{StaticResource Panel}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <UniformGrid x:Name="TimelineFilmstrip" Rows="1" Visibility="Collapsed"/>
                                        <Border x:Name="TimelineFilmstripShade" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#59101218" Offset="0"/>
                                                    <GradientStop Color="#00101218" Offset="0.22"/>
                                                    <GradientStop Color="#00101218" Offset="0.78"/>
                                                    <GradientStop Color="#59101218" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock x:Name="TimelineMediaIcon" Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0"/>
                                        <TextBlock x:Name="TimelineFileName" Text="Abre un archivo para comenzar" Foreground="{StaticResource Muted}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="TrimSelection" Height="54" Canvas.Top="2" Background="#4A8B6BE8"
                                            BorderBrush="{StaticResource Accent}" BorderThickness="1,0" Visibility="Collapsed"/>
                                </Canvas>
                                <Slider x:Name="PositionSlider" IsEnabled="False" IsMoveToPointEnabled="True"
                                        ValueChanged="OnPositionChanged" AutomationProperties.Name="Posición de reproducción">
                                    <Slider.Template>
                                        <ControlTemplate TargetType="Slider">
                                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TimelineHitArea}"/></Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TimelineHitArea}"/></Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Width="30" Cursor="SizeWE">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Grid Background="Transparent"><Border Width="2" Background="{StaticResource Accent}"/></Grid>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Slider.Template>
                                </Slider>
                                <Canvas>
                                    <Thumb x:Name="StartHandle" Style="{StaticResource TrimHandle}" Visibility="Collapsed" HorizontalContentAlignment="Right"
                                           DragStarted="OnTrimDragStarted" DragDelta="OnTrimDrag" DragCompleted="OnTrimDragCompleted"
                                           KeyDown="OnTrimKeyDown" ToolTip="Inicio del recorte"/>
                                    <Thumb x:Name="EndHandle" Style="{StaticResource TrimHandle}" Visibility="Collapsed" HorizontalContentAlignment="Left"
                                           DragStarted="OnTrimDragStarted" DragDelta="OnTrimDrag" DragCompleted="OnTrimDragCompleted"
                                           KeyDown="OnTrimKeyDown" ToolTip="Fin del recorte"/>
                                </Canvas>
                            </Grid>
                            <Grid Grid.Row="2" Margin="16,5,16,0">
                                <TextBlock x:Name="TrimSummary" Text="Sin selección" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Ctrl + rueda para zoom" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Background="{StaticResource Window}">
                <TextBlock x:Name="StatusLabel" Text="Listo · Procesamiento local" Foreground="{StaticResource Muted}"
                           FontSize="11" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="LOCAL" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
