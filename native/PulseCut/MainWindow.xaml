<Window x:Class="PulseCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseCut" Width="1050" Height="690" MinWidth="740" MinHeight="565"
        WindowStartupLocation="CenterScreen" Background="#101411" Foreground="#EEF3EA"
        FontFamily="Segoe UI" FontSize="14" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20" LastChildFill="True">
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="_Abrir archivo"
                    Style="{StaticResource Primary}" Click="OnOpen"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="26" FontWeight="Bold"><Run Text="Pulse"/><Run Text="Cut" Foreground="{StaticResource Accent}"/></TextBlock>
                <TextBlock Text="0.2 ALFA" Margin="13,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="278"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FileTitle" Text="Vista previa" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Background="#0B100C" CornerRadius="5" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                          MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                            <TextBlock x:Name="PreviewMessage" Text="Abre o arrastra un video o audio"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="20" Foreground="{StaticResource Muted}"/>
                        </Grid>
                    </Border>
                    <Slider x:Name="PositionSlider" Grid.Row="2" Margin="0,12,0,8" IsEnabled="False"
                            IsMoveToPointEnabled="True" ValueChanged="OnPositionChanged" AutomationProperties.Name="Posición de reproducción"/>
                    <DockPanel Grid.Row="3">
                        <Button x:Name="PlayButton" Content="_Reproducir" IsEnabled="False" Click="OnPlay"/>
                        <TextBlock x:Name="PositionLabel" Text="00:00.00" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontFamily="Consolas" Foreground="{StaticResource Muted}"/>
                    </DockPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ajustes del clip" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,17"/>
                        <StackPanel x:Name="EditControls" IsEnabled="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Inicio (s)" Margin="0,0,0,5" Foreground="{StaticResource Muted}"/>
                                    <TextBox x:Name="StartBox" Text="0" TextChanged="OnSettingsChanged" AutomationProperties.Name="Inicio en segundos"/>
                                    <Button Content="Usar posición" Margin="0,6,0,0" Click="OnMarkStart"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fin (s)" Margin="0,0,0,5" Foreground="{StaticResource Muted}"/>
                                    <TextBox x:Name="EndBox" Text="0" TextChanged="OnSettingsChanged" AutomationProperties.Name="Fin en segundos"/>
                                    <Button Content="Usar posición" Margin="0,6,0,0" Click="OnMarkEnd"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Velocidad de salida" Margin="0,18,0,5" Foreground="{StaticResource Muted}"/>
                            <ComboBox x:Name="SpeedBox" SelectionChanged="OnSettingsChanged" Padding="7,5" AutomationProperties.Name="Velocidad de salida"/>
                            <TextBlock Text="Formato de salida" Margin="0,15,0,5" Foreground="{StaticResource Muted}"/>
                            <ComboBox x:Name="FormatBox" SelectionChanged="OnSettingsChanged" Padding="7,5" AutomationProperties.Name="Formato de salida"/>
                            <TextBlock x:Name="DurationLabel" Text="Duración final: —" Margin="0,16,0,0" Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                        <Button x:Name="ExportButton" Content="_Exportar clip" Style="{StaticResource Primary}" Margin="0,15,0,0"
                                IsEnabled="False" Click="OnExport"/>
                        <Button x:Name="CancelButton" Content="Cancelar" Margin="0,8,0,0" Visibility="Collapsed" Click="OnCancel"/>
                        <ProgressBar x:Name="ExportProgress" Height="5" Margin="0,10,0,0" Maximum="100"
                                     Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusLabel" Grid.Row="2" Margin="0,13,0,0" Foreground="{StaticResource Muted}"
                   Text="Procesamiento local en Windows" TextWrapping="Wrap" MaxHeight="52"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
